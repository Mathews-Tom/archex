+"""Single device selection point for a CUDA-free reproduction run.
+
+Added by the archex S0 replication harness. Selection order is CUDA, then MPS,
+then CPU, and RLCODER_DEVICE overrides it. Nothing here touches retrieval,
+prompt construction, generation settings, or the metric.
+"""
+
+import os
+
+import torch
+
+
+def resolve_device():
+    override = os.environ.get("RLCODER_DEVICE")
+    if override:
+        return torch.device(override)
+    if torch.cuda.is_available():
+        return torch.device("cuda")
+    if torch.backends.mps.is_available():
+        return torch.device("mps")
+    return torch.device("cpu")
+
+
+DEVICE = resolve_device()
+
+
+def to_device(tensor):
+    return tensor.to(DEVICE)
+
+
+def place(model):
+    """Place a model on the selected device without DataParallel.
+
+    DataParallel shards a batch across several GPUs. On a single device it is a
+    no-op wrapper that only changes attribute paths, so it is dropped here.
+    """
+    return model.to(DEVICE)
